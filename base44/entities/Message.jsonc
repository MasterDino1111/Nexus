{
  "name": "Message",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "Reference to Chat"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ],
      "default": "text"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs allowed to see this message (copied from the chat by the server)"
    },
    "read_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs that have read this message"
    }
  },
  "required": [
    "chat_id",
    "sender_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "participants": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
