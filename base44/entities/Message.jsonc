
{
  "name": "Message",
  "type": "object",
  "properties": {
    "chat_id": {
      "type": "string",
      "description": "Reference to Chat"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "video",
        "audio"
      ],
      "default": "text"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "chat_id",
    "sender_id",
    "content"
  ]
}


