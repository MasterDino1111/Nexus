{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Recipient (creator) user ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "video_like",
        "short_like",
        "song_like"
      ],
      "default": "video_like"
    },
    "message": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "content_title": {
      "type": "string"
    },
    "content_thumbnail": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "type",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
