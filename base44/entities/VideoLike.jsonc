{
  "name": "VideoLike",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID who liked"
    },
    "video_id": {
      "type": "string",
      "description": "Reference to Video"
    },
    "type": {
      "type": "string",
      "enum": [
        "like",
        "dislike"
      ],
      "default": "like",
      "description": "Reaction type. Older records without type count as likes."
    }
  },
  "required": [
    "user_id",
    "video_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
