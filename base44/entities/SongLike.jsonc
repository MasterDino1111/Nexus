{
  "name": "SongLike",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID who liked"
    },
    "song_id": {
      "type": "string",
      "description": "Reference to Song"
    }
  },
  "required": [
    "user_id",
    "song_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
