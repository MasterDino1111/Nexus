
{
  "name": "VideoComment",
  "type": "object",
  "properties": {
    "video_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "parent_id": {
      "type": "string",
      "description": "Reference to parent comment for replies"
    }
  },
  "required": [
    "video_id",
    "user_id",
    "content"
  ]
}


