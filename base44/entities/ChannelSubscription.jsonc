{
  "name": "ChannelSubscription",
  "type": "object",
  "properties": {
    "subscriber_id": {
      "type": "string"
    },
    "channel_user_id": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    }
  },
  "required": [
    "subscriber_id",
    "channel_user_id"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "subscriber_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "subscriber_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
