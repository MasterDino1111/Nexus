{
  "name": "Donation",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string",
      "description": "User ID of the creator receiving the donation"
    },
    "creator_name": {
      "type": "string"
    },
    "donor_id": {
      "type": "string",
      "description": "User ID of the supporter"
    },
    "donor_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Amount in EUR"
    },
    "type": {
      "type": "string",
      "enum": [
        "one_time",
        "message",
        "monthly"
      ],
      "default": "one_time"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cancelled"
      ],
      "default": "pending"
    },
    "stream_id": {
      "type": "string",
      "description": "Reference to LiveStream when the donation was made during a live stream"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "creator_id",
    "donor_id",
    "amount",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "creator_id": "{{user.id}}"
        },
        {
          "donor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
