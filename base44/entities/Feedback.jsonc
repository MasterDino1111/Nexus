{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "change"
      ],
      "default": "feature"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "done"
      ],
      "default": "open"
    }
  },
  "required": [
    "user_id",
    "title",
    "content"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
